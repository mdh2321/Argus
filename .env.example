# Anthropic API key — read by the Anthropic SDK for all AI features (digest, Ask, signals, grounding)
ANTHROPIC_API_KEY=sk-ant-...

# Exa API key — web search for the digest pipeline and source suggestion
EXA_API_KEY=...

# Telegram delivery for the weekly digest
TELEGRAM_BOT_TOKEN=123456:ABC-...
DIGEST_TELEGRAM_CHAT_ID=123456789

# Base URL used in digest links back to the app (default: http://localhost:3000)
SENTINEL_BASE_URL=http://localhost:3000
